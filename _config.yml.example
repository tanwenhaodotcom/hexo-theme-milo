# Copy to your Hexo site as _config.milo.yml
uiux:
  slogan: Your words, your space.
img:
  avatar: /images/avatar.jpg
head:
  favicon:
    ico: /favicon.svg
footer:
  copyright_since: 0
  custom_text: null
comment:
  disqus:
    shortname: ''

# Social image: absolute URL or site-local path; falls back to avatar, then bundled PNG.
seo:
  image: ''
# Built-in Atom feed; existing site feed generator takes precedence.
feed:
  enable: true
  limit: 20

# Optional native image lightbox on article pages; front matter lightbox: false opts out.
reading:
  lightbox: false

# Keep recent posts and categories sticky in the two-column layout.
sidebar:
  sticky: true
