# 复制到博客根目录，命名为 _config.milo.yml
uiux:
  slogan: '记录与分享'
img:
  avatar: '' # 填写自己添加的头像路径
head:
  favicon:
    ico: '' # 填写自己添加的图标路径
footer:
  copyright_since: 0
  custom_text: null
comment:
  disqus:
    shortname: ''

# 分享图：完整 URL 或站内路径，回退到头像及内置 PNG。
seo:
  image: ''
# 内置 Atom 订阅；站点已有 Feed 生成器优先。
feed:
  enable: true
  limit: 20

# 可选文章灯箱；文章可用 lightbox: false 单独禁用。
reading:
  lightbox: false

# 双栏布局吸附最近文章与分类区域。
sidebar:
  sticky: true
