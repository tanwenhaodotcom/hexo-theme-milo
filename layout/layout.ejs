<!doctype html><html lang="<%= config.language || 'zh-CN' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><% const seo=milo_seo(); %><title><%= seo.title %></title><meta name="description" content="<%= seo.description %>"><link rel="canonical" href="<%= seo.url %>"><%- partial('_parts/seo',{seo}) %><% if(theme.head.favicon.ico){ %><link rel="icon" href="<%= url_for(theme.head.favicon.ico) %>"><% } %><script src="<%= url_for('/js/milo.js') %>" defer></script><script>try{var mode=localStorage.getItem('milo-appearance')||localStorage.getItem('blog-appearance')||'system';document.documentElement.dataset.mode=mode==='system'?(matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light'):mode}catch(e){}</script><link rel="stylesheet" href="<%= url_for('/css/milo.css') %>"><% if(theme.uiux.bg_color || theme.uiux.link_color || theme.uiux.primary_color){ %><style>:root{<% if(theme.uiux.bg_color){ %>--bg:<%= theme.uiux.bg_color %>;<% } %><% if(theme.uiux.link_color){ %>--accent:<%= theme.uiux.link_color %>;<% } %><% if(theme.uiux.primary_color){ %>--button:<%= theme.uiux.primary_color %>;<% } %>}</style><% } %></head><body><a class="skip" href="#main">跳到正文</a><%- partial('_parts/header') %><%- body %><footer class="footer"><div>Copyright © <%= theme.footer.copyright_since>0 && theme.footer.copyright_since<new Date().getFullYear()?theme.footer.copyright_since+' – ':'' %><%= new Date().getFullYear() %> <%= config.author || config.title %></div><% if(theme.footer.custom_text){ %><div><%- Array.isArray(theme.footer.custom_text)?theme.footer.custom_text.join('<br>'):theme.footer.custom_text %></div><% } %><div><% const versions=milo_versions(); %>Powered by <a href="https://hexo.io/" rel="noopener">Hexo <%= versions.hexo %></a> · Theme <a href="https://github.com/tanwenhaodotcom/hexo-theme-milo" rel="noopener">Milo <%= versions.milo %></a></div></footer></body></html>