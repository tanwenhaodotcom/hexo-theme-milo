<main id="main" class="about"><header class="about-heading"><% if(theme.img.avatar){ %><img src="<%= url_for(theme.img.avatar) %>" alt="<%= config.author %> 的头像" width="96" height="96"><% } %><p class="eyebrow">关于我</p><h1><%= config.author || config.title %></h1><p class="about-slogan"><%= Array.isArray(theme.uiux.slogan)?theme.uiux.slogan.join(' '):theme.uiux.slogan %></p></header><section class="about-content prose"><%- page.content %></section></main>