<div class="columns"><main id="main"><header class="page-heading"><p><%= page.tag?'标签下的文章':page.category?'分类下的文章':'时光里的文字' %></p><h1><%= page.tag?'# '+page.tag:page.category || (page.year?page.year+' 年归档':'归档') %></h1><p>共 <%= page.posts.length %> 篇文章</p></header><% let year='';page.posts.sort('date',-1).each(p=>{let y=date(p.date,'YYYY');if(y!==year){year=y; %><h2 class="year"><%= y %></h2><% } %><a class="archive-row" href="<%= url_for(p.path) %>"><time><%= date(p.date,'MM-DD') %></time><span><%= p.title %></span></a><% }); %><%- partial('_parts/pager') %></main><%- partial('_parts/sidebar') %></div>