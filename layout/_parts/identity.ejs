<% const identityName=config.author || config.title,identityIntro=Array.isArray(theme.uiux.slogan)?theme.uiux.slogan.join(' '):theme.uiux.slogan; %><a class="mobile-identity" href="<%= url_for('/about/') %>"><% if(theme.img.avatar){ %><img src="<%= url_for(theme.img.avatar) %>" width="36" height="36" alt="" decoding="async"><% } %><span class="identity-copy"><strong class="identity-name"><%= identityName %></strong><% if(identityIntro){ %><span class="identity-intro"><%= identityIntro %></span><% } %></span></a>
