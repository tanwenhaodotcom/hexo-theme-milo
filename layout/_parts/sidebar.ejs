<aside class="sidebar" aria-label="博客信息"><section class="profile"><div class="profile-heading"><% if(theme.img.avatar){ %><img src="<%= url_for(theme.img.avatar) %>" width="56" height="56" alt="作者头像"><% } %><strong><%= config.author || config.title %></strong></div><p class="slogan"><%= Array.isArray(theme.uiux.slogan)?theme.uiux.slogan.join(' '):theme.uiux.slogan %></p><div class="stats"><a href="<%= url_for('/archives/') %>"><strong><%= site.posts.length %></strong><span>文章</span></a><a href="<%= url_for('/categories/') %>"><strong><%= site.categories.length %></strong><span>分类</span></a><a href="<%= url_for('/tags/') %>"><strong><%= site.tags.length %></strong><span>标签</span></a><% let total=0;site.posts.each(p=>total+=milo_words(p.content)); %><div title="已发布文章总字数：中文按字、英文按单词统计"><strong><%= total>=10000?(total/10000).toFixed(1):total.toLocaleString('zh-CN') %></strong><span><%= total>=10000?'万字':'字' %></span></div></div><a class="primary about-link" href="<%= url_for('/about/') %>">关于我</a></section><div class="sidebar-sticky<%= theme.sidebar?.sticky===false?'':' is-sticky' %>"><section class="side-section"><h2>最近文章</h2><% site.posts.sort('date',-1).limit(4).each(p=>{ %><a class="recent" href="<%= url_for(p.path) %>"><span><%= p.title %></span><time><%= date(p.date,'YYYY-MM-DD') %></time></a><% }); %></section><% if(site.categories.length){ %><section class="side-section"><h2>分类</h2><% site.categories.sort('name',1).each(c=>{ %><a class="category" href="<%= url_for(c.path) %>"><span><%= c.name %></span><span><%= c.length %></span></a><% }); %></section><% } %></div></aside>