<% let categories=page.layout==='categories',items=categories?site.categories:site.tags; %><div class="columns"><main id="main"><header class="page-heading"><p>按内容探索</p><h1><%= categories?'分类':'标签' %></h1><p>共 <%= items.length %> 个<%= categories?'分类':'标签' %></p></header><div class="chips"><% items.sort('name',1).each(item=>{ %><a href="<%= url_for(item.path) %>"><span><%= categories?'':'# ' %><%= item.name %></span><small><%= item.length %> 篇</small></a><% }); %></div><% if(!items.length){ %><p class="muted">暂无内容。</p><% } %></main><%- partial('_parts/sidebar') %></div>