<header class="topbar"><nav class="nav" aria-label="主导航"><a class="brand" href="<%= url_for('/') %>"><%= config.title %></a><div class="navlinks"><% [['/','首页'],['/archives/','归档'],['/categories/','分类']].forEach(item=>{ %><a href="<%= url_for(item[0]) %>" <% if(('/'+page.path).replace(/index.html$/,'')===item[0]){ %>aria-current="page"<% } %>><%= item[1] %></a><% }); %></div><div class="tools"><% if(theme.search.enable){ %><button class="icon-button mobile-search" aria-label="展开搜索" aria-expanded="false" aria-controls="nav-search"><%- partial('_parts/search-icon') %></button><form id="nav-search" class="nav-search" action="<%= url_for('/search/') %>" role="search"><%- partial('_parts/search-icon') %><label class="sr" for="nav-q">搜索文章</label><input id="nav-q" name="q" type="search" placeholder="搜索文章" required></form><% } %><div class="appearance"><button class="icon-button appearance-button" aria-label="外观" aria-expanded="false" aria-controls="appearance-menu"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 4a8 8 0 0 0 0 16Z" fill="currentColor"/></svg></button><div id="appearance-menu" class="appearance-menu" hidden role="group" aria-label="选择外观"><% [['system','跟随系统'],['dark','深色模式'],['light','浅色模式']].forEach(item=>{ %><button type="button" data-mode="<%= item[0] %>" aria-pressed="false"><%= item[1] %></button><% }); %></div></div></div></nav></header>