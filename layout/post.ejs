<% if(page.layout==='search'){ %><%- partial('_parts/search') %><% }else if(page.layout==='tags' || page.layout==='categories'){ %><%- partial('_parts/taxonomy') %><% }else if(page.layout==='about' || page.path==='about/index.html'){ %><%- partial('_parts/about') %><% }else{let contents=theme.toc.enable && page.toc!==false?toc(page.content,{class:'toc',list_number:false}):''; %><% if(contents || /<pre\b/i.test(page.content || '') || (theme.reading?.lightbox===true && page.lightbox!==false && /<img\b/i.test(page.content || ''))){ %><script src="<%= url_for('/js/reading.js') %>" defer></script><% } %><div class="reading <%= contents?'with-toc':'' %>"><main id="main"><header class="reading-heading"><a class="back" href="<%= url_for('/') %>">返回首页</a><h1><%- milo_title(page.title) %></h1><div class="meta"><span><%= page.author || config.author %></span><span>·</span><time datetime="<%= date_xml(page.date) %>"><%= date(page.date,'YYYY-MM-DD') %></time><% if(page.categories){page.categories.each(c=>{ %><span>·</span><a href="<%= url_for(c.path) %>"><%= c.name %></a><% });} %><span>·</span><span>约 <%= Math.max(1,Math.ceil(milo_words(page.content)/400)) %> 分钟阅读</span></div></header><% if(contents){ %><details class="mobile-toc"><summary>本文目录</summary><nav aria-label="移动端文章目录"><%- contents %></nav></details><% } %><div class="reading-progress" hidden><label class="sr" for="reading-progress">正文阅读进度</label><progress id="reading-progress" max="100" value="0"></progress><span aria-hidden="true">0%</span></div><article class="prose" id="post-content" data-lightbox="<%= theme.reading?.lightbox===true && page.lightbox!==false %>"><%- milo_reading_content(page.content) %></article><div class="article-footer"><p>发表于 <%= date(page.date,'YYYY-MM-DD') %><% if(page.updated && date(page.updated,'YYYY-MM-DD')!==date(page.date,'YYYY-MM-DD')){ %>，最后修改于 <%= date(page.updated,'YYYY-MM-DD') %><% } %></p><div class="tags"><% if(page.tags){page.tags.each(t=>{ %><a href="<%= url_for(t.path) %>"># <%= t.name %></a><% });} %></div></div><% if(is_post()){ %><nav class="post-nav" aria-label="相邻文章"><% if(page.prev){ %><a class="post-prev" rel="prev" href="<%= url_for(page.prev.path) %>"><small>← 上一篇</small><span><%= page.prev.title %></span><time datetime="<%= date_xml(page.prev.date) %>"><%= date(page.prev.date,'YYYY-MM-DD') %></time></a><% } %><% if(page.next){ %><a class="post-next" rel="next" href="<%= url_for(page.next.path) %>"><small>下一篇 →</small><span><%= page.next.title %></span><time datetime="<%= date_xml(page.next.date) %>"><%= date(page.next.date,'YYYY-MM-DD') %></time></a><% } %></nav><% } %><% if(page.comments!==false && theme.comment.disqus.shortname){ %><section class="comments"><h2>评论</h2><button class="load-comments" data-shortname="<%= theme.comment.disqus.shortname %>" data-url="<%= full_url_for(page.path.replace(/index\.html$/,'')) %>">加载评论</button><div id="disqus_thread"></div></section><% } %></main><% if(contents){ %><aside class="toc-sidebar"><h2>本文目录</h2><nav aria-label="文章目录"><%- contents %></nav></aside><% } %></div><% } %>