<div class="columns"><main id="main"><header class="page-heading"><p>记录与思考</p><h1>最新文章 <small><%= site.posts.length %></small></h1></header><% page.posts.each(p=>{let text=milo_text(p.excerpt || p.content),words=milo_words(p.content); %><article class="entry"><div class="entry-copy"><div class="meta"><% p.categories.each(c=>{ %><a href="<%= url_for(c.path) %>"><%= c.name %></a><span>·</span><% }); %><time datetime="<%= date_xml(p.date) %>"><%= date(p.date,'YYYY-MM-DD') %></time><span>·</span><span>约 <%= words>=1000?(words/1000).toFixed(1)+' 千':words %>字</span></div><h2><a href="<%= url_for(p.path) %>"><%= p.title %></a></h2><p><%= text.slice(0,210) %><%= text.length>210?'…':'' %></p></div><% if(p.cover || p.thumbnail){ %><a class="cover" href="<%= url_for(p.path) %>" tabindex="-1" aria-hidden="true"><img src="<%= url_for(p.cover || p.thumbnail) %>" alt="" loading="lazy" width="300" height="180"></a><% } %></article><% }); %><%- partial('_parts/pager') %></main><%- partial('_parts/sidebar') %></div>