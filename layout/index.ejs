<% const showIdentity=(!page.current || page.current===1) && !!(config.author || theme.img.avatar || theme.uiux.slogan?.length); %><div class="columns<%= showIdentity?' has-mobile-identity':'' %>"><% if(showIdentity){ %><%- partial('_parts/identity') %><% } %><main id="main"><h1 class="sr"><%= config.title %> · 文章列表<% if(page.current>1){ %> · 第 <%= page.current %> 页<% } %></h1><% let firstEntry=true;page.posts.each(p=>{let text=milo_text(p.excerpt || p.content),words=milo_words(p.content); %><article class="entry"><div class="entry-copy<%= p.cover || p.thumbnail?' has-cover':'' %>"><div class="meta"><% p.categories.each(c=>{ %><a href="<%= url_for(c.path) %>"><%= c.name %></a><span>·</span><% }); %><time datetime="<%= date_xml(p.date) %>"><%= date(p.date,'YYYY-MM-DD') %></time><span>·</span><span>约 <%= words>=1000?(words/1000).toFixed(1)+' 千':words %>字</span></div><h2><a href="<%= url_for(p.path) %>"><%- milo_title(p.title) %></a></h2><% if(p.cover || p.thumbnail){ %><a class="cover<%= p.cover_fit==='contain'?' cover-contain':'' %>" href="<%= url_for(p.path) %>" tabindex="-1" aria-hidden="true"><img src="<%= url_for(p.cover || p.thumbnail) %>" alt="" loading="<%= firstEntry?'eager':'lazy' %>" fetchpriority="<%= firstEntry?'high':'auto' %>" decoding="async" width="300" height="180"></a><% } %><p><%= text.slice(0,210) %><%= text.length>210?'…':'' %></p></div></article><% firstEntry=false; }); %><%- partial('_parts/pager') %></main><%- partial('_parts/sidebar') %></div>