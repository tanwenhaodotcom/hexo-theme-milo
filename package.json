{
  "name": "hexo-theme-milo",
  "version": "0.4.0",
  "description": "基于 Hexo 的轻量级响应式博客主题，支持深浅色模式、文章搜索与阅读导航",
  "license": "MIT",
  "keywords": [
    "hexo",
    "theme",
    "milo"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check": "node --check scripts/milo.js && node --check source/js/milo.js && node --check source/js/reading.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node test/browser.cjs"
  },
  "files": [
    "layout",
    "scripts",
    "source",
    "languages",
    "examples",
    "_config.yml",
    "_config.yml.example",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "VERIFICATION.md",
    "PRIVACY_REVIEW.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tanwenhaodotcom/hexo-theme-milo.git"
  },
  "homepage": "https://github.com/tanwenhaodotcom/hexo-theme-milo#readme",
  "dependencies": {
    "hexo-util": "^3.3.0 || ^4.0.0",
    "image-size": "^2.0.2"
  },
  "devDependencies": {
    "hexo": "^8.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-tag": "^2.0.0",
    "jsdom": "^26.0.0"
  }
}
